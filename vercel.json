{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'static site, nothing to install'",
  "buildCommand": "echo 'site/ is prebuilt by GitHub Actions'",
  "outputDirectory": "site",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/cabinet",
      "destination": "/panel",
      "permanent": true
    },
    {
      "source": "/cabinet.html",
      "destination": "/panel",
      "permanent": true
    }
  ]
}
