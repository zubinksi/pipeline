{# Same look as the site: cream paper on a pale wall, slate ink, teal accent,
   serif text with mono labels. Email clients rarely load web fonts, so the
   stacks fall back to Georgia and the system monospace. #}
{% set serif = "'Geist Serif',Georgia,'Times New Roman',serif" %}
{% set mono = "'Geist Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace" %}
{% set ink = "#1f2933" %}{% set ink2 = "#374151" %}{% set muted = "#6b7280" %}{% set accent = "#0f766e" %}
{% set rule = "#ece8dc" %}{% set rule2 = "#ddd8ca" %}{% set paper = "#fbf9f3" %}{% set wall = "#eceae3" %}
{% set label = "font-family:" ~ mono ~ ";font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:" ~ muted ~ ";" %}
<!doctype html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>Cholesterol pipeline</title></head>
<body style="margin:0;padding:0;background:{{ wall }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ wall }};">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
<tr><td style="padding:0 4px 12px 4px;font-family:{{ serif }};font-size:16px;letter-spacing:.01em;color:{{ ink }};">CHOLESTEROL PIPELINE</td></tr>
</table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:{{ paper }};border:1px solid {{ rule2 }};border-radius:3px;font-family:{{ serif }};color:{{ ink }};">
<tr><td style="padding:28px 28px 6px 28px;">
  <div style="{{ label }}">Week of {{ today.strftime("%b %-d, %Y") }}</div>
  <div style="font-size:21px;line-height:1.35;margin-top:10px;">{{ headline }}</div>
</td></tr>

{% if changes %}
<tr><td style="padding:22px 28px 0 28px;"><div style="{{ label }}padding-bottom:6px;border-bottom:1px solid {{ rule2 }};">What moved</div></td></tr>
{% for c in changes %}
<tr><td style="padding:12px 28px;{% if not loop.last %}border-bottom:1px solid {{ rule }};{% endif %}">
  {% if c.drug %}<div style="font-family:{{ mono }};font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:{{ muted }};">{{ c.drug }} · {{ c.company }}</div>{% endif %}
  <div style="font-size:16px;line-height:1.45;margin-top:3px;">{{ c.what }} <a href="{{ c.url }}" style="font-family:{{ mono }};font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:{{ accent }};text-decoration:none;white-space:nowrap;">{{ c.source }} &rarr;</a></div>
  {% if c.why %}<div style="font-size:15px;line-height:1.45;color:{{ ink2 }};margin-top:6px;"><span style="{{ label }}">Why it matters</span> {{ c.why }}</div>{% endif %}
</td></tr>
{% endfor %}
{% endif %}

{% if horizon %}
<tr><td style="padding:24px 28px 0 28px;"><div style="{{ label }}padding-bottom:6px;border-bottom:1px solid {{ rule2 }};">On the horizon · next {{ horizon_days }} days</div></td></tr>
{% for h in horizon %}
<tr><td style="padding:10px 28px;font-size:15px;line-height:1.45;{% if not loop.last %}border-bottom:1px solid {{ rule }};{% endif %}">
  <div style="font-family:{{ mono }};font-size:11px;letter-spacing:.08em;color:{{ ink2 }};">{{ h.date|horizon_date }}</div>
  <strong style="font-weight:400;">{{ h.drug }}</strong>: <span style="color:{{ ink2 }};">{{ h.what }}</span> <a href="{{ h.url }}" style="font-family:{{ mono }};font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:{{ accent }};text-decoration:none;">Source &rarr;</a>
</td></tr>
{% endfor %}
{% endif %}

<tr><td style="padding:24px 28px 0 28px;"><div style="{{ label }}padding-bottom:6px;border-bottom:1px solid {{ rule2 }};">Pipeline</div></td></tr>
<tr><td style="padding:0 20px 8px 28px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td></td>
    {% for s in stages %}<td align="center" style="font-family:{{ mono }};font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:{{ muted }};padding:8px 0 6px;width:13%;">{{ s }}</td>{% endfor %}
  </tr>
  {% for r in rows %}
  <tr>
    <td style="padding:8px 6px 8px 0;border-top:1px solid {{ rule }};">
      <a href="{{ r.url }}" style="font-family:{{ mono }};font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:{{ ink }};text-decoration:none;">{{ r.name }}</a>{% if r.moved %} <span style="font-family:{{ mono }};color:#b45309;font-size:10px;">&#9650; MOVED</span>{% endif %}{% if r.badge %} <span style="font-family:{{ mono }};color:{{ muted }};font-size:9px;border:1px solid {{ rule2 }};border-radius:2px;padding:0 4px;white-space:nowrap;text-transform:uppercase;">{{ r.badge }}</span>{% endif %}
      <div style="font-family:{{ mono }};color:{{ muted }};font-size:9px;letter-spacing:.08em;text-transform:uppercase;margin-top:2px;">{{ r.company }} · {{ r.form }}</div>
    </td>
    {% for i in range(1, stages|length + 1) %}
    <td align="center" style="border-top:1px solid {{ rule }};">
      {% if i == r.rank %}<span style="color:{{ '#b45309' if r.moved else accent }};font-size:18px;line-height:1;">&#9679;</span>
      {% elif i < r.rank %}<span style="color:#99c9c3;font-size:12px;line-height:1;">&#9679;</span>
      {% else %}<span style="color:#d6d3ca;font-size:12px;line-height:1;">&#9675;</span>{% endif %}
    </td>
    {% endfor %}
  </tr>
  {% endfor %}
</table>
</td></tr>

<tr><td style="padding:16px 28px 26px 28px;font-family:{{ mono }};font-size:9.5px;letter-spacing:.08em;line-height:1.7;text-transform:uppercase;color:{{ muted }};">
  {% if errors %}<div style="margin-bottom:8px;color:#92400e;">Couldn't reach this week: {{ errors|join(", ") }}. Last week's data was kept for these.</div>{% endif %}
  {% if site_url %}<div style="margin-bottom:8px;"><a href="{{ site_url }}" style="color:{{ accent }};text-decoration:none;">Open the pipeline site &rarr;</a></div>{% endif %}
  Built from ClinicalTrials.gov, openFDA and news searches · every item links to its source · "why it matters" lines are AI-written · informational only, not medical advice
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
