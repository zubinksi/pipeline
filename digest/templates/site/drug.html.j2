{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ drug.brand ~ " (" ~ drug.name ~ ")" if drug.brand else drug.name }} · {{ site_title }}{% endblock %}
{% block head %}{{ m.slab_head("drugs") }}{% endblock %}
{% block content %}

<a class="back" href="{{ root }}drugs.html">&larr; Drugs</a>
<div class="dtop">
  <h2 class="dname"><span>{{ drug.brand or drug.name }}{% if drug.brand %}<span class="generic">{{ drug.name|lower }}</span>{% endif %}</span><span class="sponsor">{{ drug.company }}</span>{{ m.badge(drug.badge) }}{% if row.moved %}<span class="tag moved">&#9650; moved this week</span>{% endif %}</h2>
  {% if drug.plain %}<p class="dsum">{{ drug.plain }}</p>{% endif %}
</div>

{# The key results in one strip, like the results row of a lab sheet. #}
{% set route_label = {"injection": "Shot", "infusion": "Infusion", "oral": "Pill", "pill": "Pill"}.get(drug.route, "Dosing") %}
<div class="strip-wrap">
<div class="strip-head">{{ row.stage_plain }}</div>
<dl class="strip">
  <div><dt>{{ effect_label }}</dt><dd>{% if drug.effect_source %}<a class="strip-src" href="{{ drug.effect_source }}" rel="noopener noreferrer" title="Source">{% endif %}{{ (drug.effect_short or drug.effect or drug.lowers)|replace("LDL ", "")|replace("Lp(a) ", "")|replace("Weight ", "") }}{% if drug.effect_source %}</a>{% endif %}</dd></div>
  <div><dt>{{ route_label }}</dt><dd>{{ drug.often or drug.form or "–" }}</dd></div>
  {% if drug.proven %}<div><dt>{{ (topic.outcome or {}).title or "Outcomes" }}</dt><dd class="pf-{{ drug.proven }}">{% if drug.proven == 'yes' %}&#10003; {% elif drug.proven == 'failed' %}&#10007; {% endif %}{{ row.proven_short }}</dd></div>{% endif %}
</dl>
</div>

{% if milestones %}
<section class="section">
  <div class="section-head"><h2>Upcoming readouts</h2></div>
  <div class="tl-list">
  {% for h in milestones %}
  <a class="tl tl-item{{ ' due' if h.when == 'DUE NOW' }}" href="{{ h.url }}" rel="noopener noreferrer">
    <span class="tl-when">{{ "ANY WEEK NOW" if h.when == 'DUE NOW' else h.when }}</span>
    <span class="tl-what">{{ h.short or h.what }}{% if h.context %}<span class="tl-ctx">{{ h.context }}</span>{% endif %}<span class="tl-src">Source &rarr;</span></span>
    <span class="go" aria-hidden="true">&rsaquo;</span>
  </a>
  {% endfor %}
  </div>
</section>
{% endif %}

{# For a drug whose heart-attack trials are listed under "Upcoming readouts", the
   evidence note would only repeat them. #}
{% set show_proof_note = drug.proven_note and not (drug.proven == "testing" and milestones) %}
{% if show_proof_note or drug.note %}
<section class="section">
  <div class="section-head"><h2>Notes</h2></div>
  <div class="plain-terms">
    {% if show_proof_note %}<p><span class="label">{{ (topic.outcome or {}).title or "Outcomes" }}</span>{{ drug.proven_note }}{% if drug.proven_source %} <a class="src" href="{{ drug.proven_source }}" rel="noopener noreferrer">Source &rarr;</a>{% endif %}</p>{% endif %}
    {% if drug.note %}<p><span class="label">Status</span>{{ drug.note }}{% if drug.sources %} <a class="src" href="{{ drug.sources[0] }}" rel="noopener noreferrer">Source &rarr;</a>{% endif %}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if updates %}
<section class="section">
  <div class="section-head"><h2>News</h2></div>
  {{ m.changes(updates, root, show_drug=false) }}
</section>
{% endif %}

<details class="more">
  <summary>Trials and technical details ({{ trials|length }})</summary>
  <div>
    <dl class="facts">
      {% if drug.aliases %}<dt>Also known as</dt><dd>{{ drug.aliases|join(", ") }}</dd>{% endif %}
      {% if drug.target %}<dt>Works on</dt><dd>{{ drug.target }}</dd>{% endif %}
      <dt>Active trials</dt><dd>{{ n_active }} of {{ trials|length }}</dd>
      {% if next_pcd %}<dt>Next trial finishing</dt><dd>{{ next_pcd.primary_completion|horizon_date }} · {{ next_pcd.acronym or next_pcd.nct }} (estimated)</dd>{% endif %}
      <dt>Stage based on</dt><dd>
        {% if stage_basis.basis and stage_basis.basis.startswith("NCT") %}<a href="{{ stage_basis.url }}">{{ stage_basis.basis }}</a> on ClinicalTrials.gov
        {% elif stage_basis.basis == "FDA" %}<a href="{{ stage_basis.url }}">FDA approval record</a>
        {% else %}Watchlist{% if drug.sources %} (<a href="{{ drug.sources[0] }}">source</a>){% endif %}{% endif %}
      </dd>
    </dl>
    {% if history|length > 1 %}
    <dl class="facts">{% for h in history %}<dt>{{ h.date|nice_date }}</dt><dd>{{ h.label }}</dd>{% endfor %}</dl>
    {% endif %}
    {% if trials %}
    <div class="scroll"><table class="trials">
      <thead><tr><th>Trial</th><th>Phase</th><th>Status</th><th>Main results due</th></tr></thead>
      <tbody>
      {% for t in trials %}
        <tr>
          <td><a href="{{ t.url }}">{{ t.acronym or t.nct }}</a>{% if t.has_results %} <span class="tag">results</span>{% endif %}<div class="t-title">{{ t.title[:90] }}</div></td>
          <td class="nowrap">{{ t.phase }}</td>
          <td>{{ t.status_plain }}</td>
          <td class="nowrap">{{ t.primary_completion or "–" }}{% if t.primary_completion_type == "ESTIMATED" %} <span class="est">est.</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% endif %}
  </div>
</details>
{% endblock %}
