{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ drug.name }} · {{ site_title }}{% endblock %}
{% block content %}
<div class="d-title"><h1>{{ drug.name }}</h1><span class="amt">{{ row.stage_label }}</span></div>
<div class="d-sub"><span>{{ drug.company }}{% if drug.target %} · {{ drug.target }}{% endif %}</span>{% if drug.badge or row.moved %}<span>{% if row.moved %}<span class="tag moved">&#9650; moved this week</span> {% endif %}{% if drug.badge %}<span class="tag">{{ drug.badge }}</span>{% endif %}</span>{% endif %}</div>
{% if drug.plain %}<p class="lede">{{ drug.plain }}</p>{% endif %}

<div class="module">
  {{ m.stage_head() }}
  <div class="strip-row"><div class="name"><span class="label">Stage</span></div>{{ m.track(row.rank, row.moved) }}</div>
</div>

<dl class="facts">
  {% if drug.form %}<dt>Form</dt><dd>{{ drug.form }}</dd>{% endif %}
  <dt>Trials tracked</dt><dd><span class="mono">{{ trials|length }}</span> · {{ n_active }} active</dd>
  {% if next_pcd %}<dt>Next completion</dt><dd><span class="mono">{{ next_pcd.primary_completion }}</span> · {{ next_pcd.acronym or next_pcd.nct }} (primary completion, est.)</dd>{% endif %}
  {% if drug.aliases %}<dt>Also known as</dt><dd>{{ drug.aliases|join(", ") }}</dd>{% endif %}
  {% if drug.note %}<dt>Status note</dt><dd>{{ drug.note }}</dd>{% endif %}
  <dt>Stage based on</dt><dd>
    {% if stage_basis.basis and stage_basis.basis.startswith("NCT") %}<a href="{{ stage_basis.url }}">{{ stage_basis.basis }}</a> on ClinicalTrials.gov
    {% elif stage_basis.basis == "FDA" %}<a href="{{ stage_basis.url }}">FDA approval record</a>
    {% else %}Watchlist{% if drug.sources %} (<a href="{{ drug.sources[0] }}">source</a>){% endif %}{% endif %}
  </dd>
</dl>

<div class="module">
  <div class="module-head"><span class="label">Updates</span></div>
  {% if updates %}{{ m.changes(updates, root, show_drug=false) }}
  {% else %}<p class="empty">No changes recorded since tracking started.</p>{% endif %}
</div>

{% if history|length > 1 %}
<div class="module">
  <div class="module-head"><span class="label">Stage history</span></div>
  {% for h in history %}<div class="w-row"><span class="w-when">{{ h.date|nice_date }}</span><span class="w-head">{{ h.label }}</span></div>{% endfor %}
</div>
{% endif %}

<div class="module">
  <div class="module-head"><span class="label">Trials on ClinicalTrials.gov</span></div>
  {% if trials %}
  <div class="scroll"><table class="trials">
    <thead><tr><th>Trial</th><th>Phase</th><th>Status</th><th>Primary completion</th></tr></thead>
    <tbody>
    {% for t in trials %}
      <tr>
        <td><a href="{{ t.url }}">{{ t.acronym or t.nct }}</a>{% if t.has_results %} <span class="tag">results</span>{% endif %}<div class="t-title">{{ t.title[:90] }}</div></td>
        <td class="nowrap">{{ t.phase }}</td>
        <td>{{ t.status_plain }}</td>
        <td class="nowrap">{{ t.primary_completion or "–" }}{% if t.primary_completion_type == "ESTIMATED" %} <span class="est">est.</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}<p class="empty">None found yet.</p>{% endif %}
</div>
{% endblock %}
