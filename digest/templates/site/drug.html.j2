{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ drug.brand ~ " (" ~ drug.name ~ ")" if drug.brand else drug.name }} · {{ site_title }}{% endblock %}
{% block head %}{{ m.slab_head("drugs", back=root ~ "drugs.html") }}{% endblock %}
{% block content %}

<div class="dtop">
  <h2 class="dname">{{ drug.brand or drug.name }}{% if drug.brand %}<span class="generic">{{ drug.name|lower }}</span>{% endif %}{{ m.badge(drug.badge) }}{% if row.moved %}<span class="tag moved">&#9650; moved this week</span>{% endif %}</h2>
  {% if drug.plain %}<p class="dsum">{{ drug.plain }}</p>{% endif %}
</div>

{# The essentials, laid out like a results table: one fact per line. #}
<section class="section">
  <div class="section-head"><h2>At a glance</h2></div>
  <dl class="gl">
    <div><dt>How often</dt><dd>{{ drug.form or "–" }}</dd></div>
    <div><dt>Effect</dt><dd>{{ drug.effect or ("Lowers " ~ drug.lowers if drug.lowers else "–") }}{% if drug.effect_source %} <a class="src" href="{{ drug.effect_source }}" rel="noopener noreferrer">Source &rarr;</a>{% endif %}</dd></div>
    {% if drug.proven %}<div><dt>Heart attacks</dt><dd><span class="pf pf-{{ drug.proven }}">{% if drug.proven == 'yes' %}&#10003; {% elif drug.proven == 'failed' %}&#10007; {% endif %}{{ row.proven_label }}</span></dd></div>{% endif %}
    <div><dt>Status</dt><dd class="gl-stage"><span>{{ row.stage_plain }}</span>{{ m.mini(row.rank, row.moved) }}</dd></div>
    <div><dt>Made by</dt><dd>{{ drug.company }}</dd></div>
  </dl>
</section>

{% if milestones %}
<section class="section">
  <div class="section-head"><h2>What's next</h2></div>
  <div class="tl-list">
  {% for h in milestones %}
  <a class="tl tl-item{{ ' due' if h.when == 'DUE NOW' }}" href="{{ h.url }}" rel="noopener noreferrer">
    <span class="tl-when">{{ "ANY WEEK NOW" if h.when == 'DUE NOW' else h.when }}</span>
    <span class="tl-what">{{ h.short or h.what }}{% if h.context %}<span class="tl-ctx">{{ h.context }}</span>{% endif %}<span class="tl-src">Source &rarr;</span></span>
    <span class="go" aria-hidden="true">&rsaquo;</span>
  </a>
  {% endfor %}
  </div>
</section>
{% endif %}

{# For a drug whose heart-attack trials are listed under "What's next", the
   evidence note would only repeat them. #}
{% set show_proof_note = drug.proven_note and not (drug.proven == "testing" and milestones) %}
{% if show_proof_note or drug.note %}
<section class="section">
  <div class="section-head"><h2>In plain terms</h2></div>
  <div class="plain-terms">
    {% if show_proof_note %}<p><span class="label">Heart attacks</span>{{ drug.proven_note }}{% if drug.proven_source %} <a class="src" href="{{ drug.proven_source }}" rel="noopener noreferrer">Source &rarr;</a>{% endif %}</p>{% endif %}
    {% if drug.note %}<p><span class="label">Where it stands</span>{{ drug.note }}{% if drug.sources %} <a class="src" href="{{ drug.sources[0] }}" rel="noopener noreferrer">Source &rarr;</a>{% endif %}</p>{% endif %}
  </div>
</section>
{% endif %}

{% if updates %}
<section class="section">
  <div class="section-head"><h2>News</h2></div>
  {{ m.changes(updates, root, show_drug=false) }}
</section>
{% endif %}

<details class="more">
  <summary>Trials and technical details ({{ trials|length }})</summary>
  <div>
    <dl class="facts">
      {% if drug.aliases %}<dt>Also known as</dt><dd>{{ drug.aliases|join(", ") }}</dd>{% endif %}
      {% if drug.target %}<dt>Works on</dt><dd>{{ drug.target }}</dd>{% endif %}
      <dt>Active trials</dt><dd>{{ n_active }} of {{ trials|length }}</dd>
      {% if next_pcd %}<dt>Next trial finishing</dt><dd>{{ next_pcd.primary_completion|horizon_date }} · {{ next_pcd.acronym or next_pcd.nct }} (estimated)</dd>{% endif %}
      <dt>Stage based on</dt><dd>
        {% if stage_basis.basis and stage_basis.basis.startswith("NCT") %}<a href="{{ stage_basis.url }}">{{ stage_basis.basis }}</a> on ClinicalTrials.gov
        {% elif stage_basis.basis == "FDA" %}<a href="{{ stage_basis.url }}">FDA approval record</a>
        {% else %}Watchlist{% if drug.sources %} (<a href="{{ drug.sources[0] }}">source</a>){% endif %}{% endif %}
      </dd>
    </dl>
    {% if history|length > 1 %}
    <dl class="facts">{% for h in history %}<dt>{{ h.date|nice_date }}</dt><dd>{{ h.label }}</dd>{% endfor %}</dl>
    {% endif %}
    {% if trials %}
    <div class="scroll"><table class="trials">
      <thead><tr><th>Trial</th><th>Phase</th><th>Status</th><th>Main results due</th></tr></thead>
      <tbody>
      {% for t in trials %}
        <tr>
          <td><a href="{{ t.url }}">{{ t.acronym or t.nct }}</a>{% if t.has_results %} <span class="tag">results</span>{% endif %}<div class="t-title">{{ t.title[:90] }}</div></td>
          <td class="nowrap">{{ t.phase }}</td>
          <td>{{ t.status_plain }}</td>
          <td class="nowrap">{{ t.primary_completion or "–" }}{% if t.primary_completion_type == "ESTIMATED" %} <span class="est">est.</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% endif %}
  </div>
</details>
{% endblock %}
