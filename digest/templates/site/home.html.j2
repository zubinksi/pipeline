{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}{{ "Drugs · " if active == "drugs" }}{{ site_title }}{% endblock %}
{% block head %}{{ m.slab_head(active) }}{% endblock %}
{% block content %}
<div class="panel" data-panel="news"{% if active != "news" %} hidden{% endif %}>
{% if latest %}{{ m.this_week(latest, root, "This week", past=n_weeks) }}
{% else %}<p class="empty">No weekly runs yet.</p>{% endif %}
</div>
<div class="panel" data-panel="drugs"{% if active != "drugs" %} hidden{% endif %}>
{{ m.drug_list(sections, root, filterable=true) }}
{{ m.explainer() }}
</div>
{% endblock %}
