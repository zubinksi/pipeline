<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% block title %}{{ site_title }}{% endblock %}</title>
<meta name="robots" content="noindex">
<meta name="theme-color" content="#2c4a7a">
<meta name="referrer" content="no-referrer">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='3' fill='%23fbf9f3'/><circle cx='8' cy='8' r='3.5' fill='%232c4a7a'/></svg>">
<link rel="preload" href="{{ root }}assets/fonts/GeistSerif-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}assets/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/site.css">
</head>
<body>
<main class="body">
  <div class="slab">
    {% block content %}{% endblock %}
  </div>
</main>
<footer>
  Built from ClinicalTrials.gov, openFDA and news searches{% if updated %}, last checked {{ updated|nice_date }}{% endif %}.
</footer>
<script src="{{ root }}assets/filter.js" defer></script>
</body>
</html>
