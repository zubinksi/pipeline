{% import "_macros.html.j2" as m with context %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% block title %}{{ site_title }}{% endblock %}</title>
<meta name="robots" content="noindex">
<meta name="theme-color" content="#8f9186">
<link rel="icon" type="image/png" sizes="32x32" href="{{ root }}assets/favicon-32.png">
<link rel="preload" href="{{ root }}assets/fonts/GeistSerif-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}assets/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/site.css">
</head>
<body>
<header class="mast">
  <a href="{{ root }}index.html">
    <span class="mast-iris" aria-hidden="true"></span>
    <span>
      <span class="mast-title" style="display:block">CHOLESTEROL PIPELINE</span>
      <span class="mast-line2"><span class="mast-of">of</span><span class="mast-title">THE BROWNS</span></span>
    </span>
  </a>
</header>
<main class="body">
  <div class="slab">
    <nav class="sidebar" aria-label="Drugs">
      <a class="side-top" href="{{ root }}index.html"><span>Pipeline</span><span>{{ side.rows|length }}</span></a>
      <div class="side-sub">{{ side.sub }}</div>
      <div class="side-rule"></div>
      {% for r in side.rows %}
      <a class="side-row{{ ' is-sel' if r.id == sel }}" href="{{ root }}drugs/{{ r.id }}.html">
        <span class="side-name">{{ r.name }}{% if r.moved %}<span class="side-dot" title="moved this week"></span>{% endif %}</span>
        <span class="side-bar"><span style="width:{{ r.rank * 20 }}%"></span></span>
        <span class="side-stage">{{ r.stage_short }}</span>
      </a>
      {% endfor %}
      <a class="side-foot{{ ' is-sel' if sel == 'weeks' }}" href="{{ root }}weeks/index.html"><span>Past weeks</span><span class="n">{{ side.n_weeks }}</span></a>
    </nav>
    <section class="detail">
      {% block content %}{% endblock %}
    </section>
  </div>
</main>
<footer>
  Built from ClinicalTrials.gov, openFDA and news searches{% if updated %} · last checked {{ updated|nice_date }}{% endif %}<br>
  Every update links to its source · "Why it matters" lines are AI-written from those updates · Informational only, not medical advice
</footer>
</body>
</html>
