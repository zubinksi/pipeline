<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% block title %}{{ site_title }}{% endblock %}</title>
<meta name="robots" content="noindex">
<meta name="theme-color" content="#172740">
<meta name="referrer" content="no-referrer">
<link rel="icon" type="image/png" sizes="32x32" href="{{ root }}assets/icon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="{{ root }}assets/icon-192.png">
<link rel="apple-touch-icon" href="{{ root }}assets/icon-180.png">
<link rel="preload" href="{{ root }}assets/fonts/GeistSerif-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}assets/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/site.css">
{% block headextra %}{% endblock %}
</head>
<body>
<main class="body">
  <div class="slab{{ ' tabbed' if sel in ('news', 'drugs', 'weeks', 'panel', 'labs') }}" data-theme="{{ 'drugs' if sel == 'drugs' else 'news' }}"{% if sel in ('panel', 'labs') %} data-page="panel"{% endif %}>
    {% block head %}{% endblock %}
    <div class="slab-body">
    {% block content %}{% endblock %}
    </div>
  </div>
</main>
<footer>
  Report generated{% if updated %} {{ updated|nice_date }}{% endif %} · Sources: ClinicalTrials.gov, openFDA, news searches
</footer>
<script type="application/json" id="panel-data">{{ panel_data|safe }}</script>
<script src="{{ root }}assets/panel.js" defer></script>
<script src="{{ root }}assets/filter.js" defer></script>
<script src="{{ root }}assets/tabs.js" defer></script>
<script src="{{ root }}assets/newmark.js" defer></script>
{% if sel == "labs" %}<script src="{{ root }}assets/labs.js" defer></script>{% endif %}
</body>
</html>
