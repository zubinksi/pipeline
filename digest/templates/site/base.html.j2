<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% block title %}{{ site_title }}{% endblock %}</title>
<meta name="robots" content="noindex">
<meta name="theme-color" content="#172740">
<meta name="referrer" content="no-referrer">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' rx='3' fill='%23fbf9f3'/><circle cx='8' cy='8' r='3.5' fill='%232c4a7a'/></svg>">
<link rel="preload" href="{{ root }}assets/fonts/GeistSerif-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}assets/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/site.css">
{% block headextra %}{% endblock %}
</head>
<body>
<main class="body">
  <div class="slab{{ ' tabbed' if sel in ('news', 'drugs', 'weeks', 'cabinet') }}" data-theme="{{ 'drugs' if sel == 'drugs' else 'news' }}"{% if sel == 'cabinet' %} data-page="cabinet"{% endif %}>
    {% block head %}{% endblock %}
    <div class="slab-body">
    {% block content %}{% endblock %}
    </div>
  </div>
</main>
<footer>
  Report generated{% if updated %} {{ updated|nice_date }}{% endif %} · Sources: ClinicalTrials.gov, openFDA, news searches
</footer>
<script type="application/json" id="cabinet-data">{{ cabinet_data|safe }}</script>
<script src="{{ root }}assets/cabinet.js" defer></script>
<script src="{{ root }}assets/filter.js" defer></script>
<script src="{{ root }}assets/tabs.js" defer></script>
</body>
</html>
