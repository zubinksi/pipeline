{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}Past weeks · {{ site_title }}{% endblock %}
{% block head %}{{ m.slab_head("news", back=root ~ "index.html") }}{% endblock %}
{% block content %}
<section class="section">
  <div class="section-head"><h2>Past weeks <span class="sub">· {{ weeks|length }}</span></h2></div>
  {% if weeks %}{{ m.week_list(weeks, "") }}
  {% else %}<p class="empty">No weekly runs yet.</p>{% endif %}
</section>
{% endblock %}
