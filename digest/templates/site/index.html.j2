{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block content %}
<section class="card">
  {% if latest %}
  <div class="eyebrow">Week of {{ latest.date|nice_date }}</div>
  <h1>{{ latest.headline }}</h1>
  {% if latest.errors %}<div class="warn">Couldn't reach this week: {{ latest.errors|join(", ") }}. Last week's data was kept for these.</div>{% endif %}
  {% else %}
  <h1>No weekly runs yet.</h1>
  {% endif %}
</section>

{% if latest %}{{ m.week_body(latest, root, horizon_days) }}{% endif %}

<section class="card">
  <h2>Pipeline</h2>
  {{ m.strip(rows, root) }}
</section>

{% if weeks|length > 1 %}
<section class="card">
  <h2>Recent weeks</h2>
  <ul class="plain weeks">
  {% for w in weeks[1:] %}
    <li><span class="when">{{ w.date|nice_date }}</span><a href="weeks/{{ w.date }}.html">{{ w.headline }}</a></li>
  {% endfor %}
  </ul>
  {% if n_weeks > weeks|length %}<p><a href="weeks/index.html">All {{ n_weeks }} weeks &rarr;</a></p>{% endif %}
</section>
{% endif %}
{% endblock %}
