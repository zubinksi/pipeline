{% macro mini(rank, moved=false, big=false) -%}
<div class="mini{{ ' big' if big }}" role="img" aria-label="Step {{ rank }} of 5: {{ stages[rank-1] }}">
  {% for i in range(1, 6) %}<div class="cell {{ 'done' if i < rank else ('now' if i == rank else '') }}{{ ' moved' if moved and i == rank else '' }}"><span class="dot"></span></div>{% endfor %}
</div>
{%- endmacro %}

{% macro badge(text) -%}
{% if text %}<span class="tag{{ ' setback' if text == 'setback' }}">{{ text }}</span>{% endif %}
{%- endmacro %}

{% macro proven(r) -%}
{% if r.proven_label %}<span class="proof proof-{{ r.proven }}">{% if r.proven == 'yes' %}&#10003; {% elif r.proven == 'failed' %}&#10007; {% endif %}{{ r.proven_label }}</span>{% endif %}
{%- endmacro %}

{# The drug list, grouped by how close each drug is to a pharmacy. #}
{% macro drug_list(groups, root, title="The drugs", filterable=false) -%}
<section class="section"{% if filterable %} data-filter{% endif %}>
  <div class="section-head">
    <h2>{{ title }} <span class="sub">· {{ n_drugs }}</span></h2>
    {% if filterable and (filters.lowers|length > 1 or filters.freq|length > 1) %}
    <div class="filters" hidden>
      {% if filters.lowers|length > 1 %}<select data-k="lowers" aria-label="What it lowers">
        <option value="all">Lowers</option>
        {% for v, label in filters.lowers %}<option value="{{ v }}">{{ label }}</option>{% endfor %}
      </select>{% endif %}
      {% if filters.freq|length > 1 %}<select data-k="freq" aria-label="How often">
        <option value="all">How often</option>
        {% for v, label in filters.freq %}<option value="{{ v }}">{{ label }}</option>{% endfor %}
      </select>{% endif %}
    </div>
    {% endif %}
  </div>
  <div class="dtable">
    <div class="dhead" aria-hidden="true">
      <span>Drug</span><span>How often</span><span>Lowers</span><span>Heart attacks?</span><span class="c-stage">Stage</span><span></span>
    </div>
    {% for g in groups %}
    <div class="group" data-group>
      <h3>{{ g.title }} <span class="n" data-count>{{ g.rows|length }}</span></h3>
      {% for r in g.rows %}
      <a class="drug" href="{{ root }}drugs/{{ r.id }}.html" data-lowers="{{ r.lowers_keys|join(' ') }}" data-freq="{{ r.frequency or '' }}">
        <span class="c-name"><span class="drug-name">{{ r.display_name }}</span>{% if r.generic %}<span class="generic">{{ r.generic|lower }}</span>{% endif %}{{ badge(r.badge) }}{% if r.moved %}<span class="tag moved">&#9650; moved</span>{% endif %}</span>
        <span class="c-line"><span class="nb">{{ r.often or r.form }}</span><span class="sep">·</span>{% for part in (r.effect_short or r.effect or r.lowers).split("; ") %}<span class="nb">{{ part }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</span>
        <span class="c-often">{{ r.often or r.form }}</span>
        <span class="c-effect">{{ r.effect_short or r.effect or r.lowers }}</span>
        <span class="c-proof">{% if r.proven %}<span class="pf pf-{{ r.proven }}"><span class="pf-i" aria-hidden="true">{% if r.proven == 'yes' %}&#10003;{% elif r.proven == 'failed' %}&#10007;{% elif r.proven == 'testing' %}&#8230;{% else %}&ndash;{% endif %}</span><span class="pf-short">{{ r.proven_short }}</span><span class="pf-long">{{ r.proven_label }}</span></span>{% endif %}</span>
        <span class="c-stage">{% if r.show_stage %}<span class="words">{{ r.stage_plain }}</span>{% endif %}{{ mini(r.rank, r.moved) }}</span>
        <span class="go" aria-hidden="true">&rsaquo;</span>
      </a>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% if filterable %}<p class="empty f-empty" hidden>Nothing on the list matches. Try setting Lowers or How often back.</p>{% endif %}
</section>
{%- endmacro %}

{% macro changes(list, root, show_drug=true) -%}
{% for c in list %}
<div class="change">
  <div class="meta">
    {% if show_drug and c.drug_name %}<a href="{{ root }}drugs/{{ c.drug }}.html">{{ c.drug_name }}</a> · {% endif %}
    {% if not show_drug and c.week %}<a href="{{ root }}weeks/{{ c.week }}.html">{{ c.week|nice_date }}</a> · {% endif %}
    {{ c.kind_label }}
  </div>
  <div class="what">{{ c.what }} <a class="src" href="{{ c.url }}" rel="noopener noreferrer">{{ c.source }} &rarr;</a></div>
  {% if c.why %}<div class="why">{{ c.why }}</div>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro horizon(items) -%}
<section class="section">
  <div class="section-head"><h2>Coming up <span class="sub">· next {{ horizon_days }} days</span></h2></div>
  {% for h in items %}
  <div class="h-row">
    <div class="h-when">{{ h.date|horizon_date }}</div>
    <div class="h-what"><b>{{ h.drug }}</b>: {{ h.what }} <a class="src" href="{{ h.url }}" rel="noopener noreferrer">Source &rarr;</a></div>
  </div>
  {% endfor %}
</section>
{%- endmacro %}

{# "This week": the changes, or (on a quiet week) just the heading line. #}
{% macro this_week(w, root, title, past=0) -%}
<section class="section">
  {% set n_drug_changes = w.changes|rejectattr("kind", "equalto", "field")|list|length %}
  <div class="section-head{{ ' quiet-head' if not n_drug_changes }}"><h2>{{ title }} <span class="sub">· {{ w.date|nice_date_short }}{% if not n_drug_changes and w.quiet %} · {{ w.quiet }}{% endif %}</span></h2>{% if past %}<a class="btn" href="{{ root }}weeks/index.html">Past weeks &rarr;</a>{% endif %}</div>
  {% if w.errors %}<div class="note" style="margin-top:0.625rem">Couldn't reach: {{ w.errors|join(", ") }}.{% if not w.baseline %} The previous week's data was kept for these.{% endif %}</div>{% endif %}
  {% set drug_changes = w.changes|rejectattr("kind", "equalto", "field")|list %}
  {% if drug_changes %}{{ changes(drug_changes, root) }}{% endif %}
</section>
{% set field = w.changes|selectattr("kind", "equalto", "field")|list %}
{% if field %}
<section class="section">
  <div class="section-head"><h2>In the field <span class="sub">· beyond your list</span></h2></div>
  {% for c in field %}
  <div class="change">
    <div class="what">{{ c.what }} <a class="src" href="{{ c.url }}" rel="noopener noreferrer">{{ c.source }} &rarr;</a></div>
    {% if c.why %}<div class="why">{{ c.why }}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}
{% if w.horizon %}{{ horizon(w.horizon) }}{% endif %}
{%- endmacro %}

{% macro explainer() -%}
<details class="explain">
  <summary>How to read this</summary>
  <div class="explain-body">
    <div>
      <h4>How far along</h4>
      <dl>
        <dt>Early safety tests</dt><dd>First tests in people, mainly for safety.</dd>
        <dt>Mid-stage testing</dt><dd>Does it work, and at what dose?</dd>
        <dt>Final-stage trials</dt><dd>Large trials, often testing whether it prevents heart attacks. The last step before applying for approval.</dd>
        <dt>FDA reviewing</dt><dd>The company has applied for approval.</dd>
        <dt>Approved</dt><dd>Doctors can prescribe it.</dd>
      </dl>
      <p style="margin-top:0.75rem">Many drugs stop along the way. Even final-stage drugs are usually a few years from pharmacies.</p>
    </div>
    <div>
      <h4>LDL</h4>
      <p>The "bad" cholesterol that statins lower. Every drug here lowers LDL without being a statin or a daily pill. The percentages are how much LDL fell in trials, on top of whatever people were already taking.</p>
      <h4 style="margin-top:1rem">Heart attacks</h4>
      <p>Lowering LDL isn't automatically the same as preventing heart attacks. "Prevents heart attacks" means a large trial showed fewer heart attacks and strokes; the others haven't been tested that way yet.</p>
      <p style="margin-top:0.75rem">This is a news tracker, not medical advice.</p>
    </div>
  </div>
</details>
{%- endmacro %}

{% macro week_list(weeks, prefix) -%}
{% for w in weeks %}
<a class="w-row" href="{{ prefix }}{{ w.date }}.html"><span class="w-when">{{ w.date|nice_date }}</span><span class="w-head">{{ w.headline }}</span></a>
{% endfor %}
{%- endmacro %}
