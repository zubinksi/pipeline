{% macro mini(rank, moved=false, big=false) -%}
<div class="mini{{ ' big' if big }}" role="img" aria-label="Step {{ rank }} of 5: {{ stages[rank-1] }}">
  {% for i in range(1, 6) %}<div class="cell {{ 'done' if i < rank else ('now' if i == rank else '') }}{{ ' moved' if moved and i == rank else '' }}"><span class="dot"></span></div>{% endfor %}
</div>
{%- endmacro %}

{% macro badge(text) -%}
{% if text %}<span class="tag{{ ' setback' if text == 'setback' }}">{{ text }}</span>{% endif %}
{%- endmacro %}

{% macro proven(r) -%}
{% if r.proven_label %}<span class="proof proof-{{ r.proven }}">{% if r.proven == 'yes' %}&#10003; {% elif r.proven == 'failed' %}&#10007; {% endif %}{{ r.proven_label }}</span>{% endif %}
{%- endmacro %}

{# The drug list: a block per topic, each grouped by how close a drug is to a pharmacy. #}
{% macro drug_list(sections, root, title="The drugs", filterable=false) -%}
<section class="section"{% if filterable %} data-filter{% endif %}>
  <div class="section-head">
    <h2>{{ title }} <span class="sub" data-total>{{ n_drugs }}</span></h2>
    {% set fdefs = [("tp", filters.tp, "Topic"), ("st", filters.st, "Stage"), ("lowers", filters.lowers, "Cholesterol"), ("freq", filters.freq, "How often")] %}
    {% set has_filters = filterable and (fdefs|selectattr(1, "ne", none)|map(attribute=1)|map("length")|max > 1) %}
    {% if has_filters %}
    <button type="button" class="ficon" aria-expanded="false" aria-controls="fpanel" aria-label="Filter" hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3.5h12M4.5 8h7M7 12.5h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/></svg>
      <span class="fcount" hidden></span>
    </button>
    {% endif %}
  </div>
  {% if has_filters %}
  <div class="fpanel" id="fpanel" hidden>
    {% for k, opts, flabel in fdefs if opts|length > 1 %}
    <div class="fgroup">
      <span class="label">{{ flabel }}</span>
      <div class="chips" role="group" aria-label="{{ flabel }}">
        <button type="button" class="chip" data-k="{{ k }}" data-v="all" aria-pressed="true">All</button>
        {% for v, label in opts %}<button type="button" class="chip" data-k="{{ k }}" data-v="{{ v }}" aria-pressed="false">{{ label }}</button>{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% for t in sections %}
  <div class="tsec" data-topic-sec="{{ t.id }}">
    {% if sections|length > 1 %}<h3 class="tsec-head">{{ t.title }} <span class="n" data-tcount>{{ t.n }}</span></h3>{% endif %}
    <div class="dtable">
      <div class="dhead" aria-hidden="true">
        <span>Drug</span><span>{{ t.effect_col or "Effect" }}</span><span>How often</span><span>{{ (t.outcome or {}).col or "Outcome" }}</span><span class="c-stage">Stage</span><span></span>
      </div>
      {% for g in t.groups %}
      <div class="group" data-group>
        <h3>{{ g.title }} <span class="n" data-count>{{ g.rows|length }}</span></h3>
        {% for r in g.rows %}
        <a class="drug" href="{{ root }}drugs/{{ r.id }}.html" data-drug="{{ r.id }}" data-tp="{{ r.topic }}" data-st="{{ g.key }}" data-lowers="{{ r.lowers_keys|join(' ') }}" data-freq="{{ r.frequency or '' }}">
          <span class="c-name"><span class="drug-name">{{ r.display_name }}</span>{% if r.generic %}<span class="generic">{{ r.generic|lower }}</span>{% endif %}{{ badge(r.badge) }}{% if r.moved %}<span class="tag moved">&#9650; moved</span>{% endif %}</span>
          <span class="c-line"><span class="nb">{{ r.often or r.form }}</span><span class="sep">·</span>{% for part in (r.effect_short or r.effect or r.lowers).split("; ") %}<span class="nb">{{ part }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</span>
          <span class="c-one"><span>{{ (r.effect_short or r.effect or r.lowers).split("; ")[0] }}</span><span class="sep">·</span><span>{{ r.often or r.form }}</span></span>
          <span class="c-effect">{{ r.effect_short or r.effect or r.lowers }}</span>
          <span class="c-often">{{ r.often or r.form }}</span>
          <span class="c-proof">{% if r.proven %}<span class="pf pf-{{ r.proven }}">{% if r.proven == 'yes' %}<span class="pf-i" aria-hidden="true">&#10003;</span>{% elif r.proven == 'failed' %}<span class="pf-i" aria-hidden="true">&#10007;</span>{% endif %}<span class="pf-short">{{ r.proven_short }}</span><span class="pf-long">{{ r.proven_label }}</span></span>{% endif %}</span>
          <span class="c-stage">{% if r.show_dots %}{{ mini(r.rank, r.moved) }}<span class="words">{{ r.stage_plain }}</span>{% endif %}</span>
          <span class="go" aria-hidden="true">&rsaquo;</span>
        </a>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
  <p class="empty cab-empty" hidden>Nothing here from your cabinet. <a href="{{ root }}cabinet.html">Choose what to follow &rarr;</a></p>
  {% if filterable %}<p class="empty f-empty" hidden>Nothing on the list matches. Try "All".</p>{% endif %}
</section>
{%- endmacro %}

{% macro changes(list, root, show_drug=true) -%}
{% for c in list %}
<div class="change"{% if c.drug %} data-drug="{{ c.drug }}"{% elif c.topic %} data-topic="{{ c.topic }}"{% endif %}>
  <div class="meta">
    {% if show_drug and c.drug_name %}<a href="{{ root }}drugs/{{ c.drug }}.html">{{ c.drug_name }}</a> · {% endif %}
    {% if not show_drug and c.week %}<a href="{{ root }}weeks/{{ c.week }}.html">{{ c.week|nice_date }}</a> · {% endif %}
    {{ c.kind_label }}
  </div>
  <div class="what">{{ c.what }} <a class="src" href="{{ c.url }}" rel="noopener noreferrer">{{ c.source }} &rarr;</a></div>
  {% if c.why %}<div class="why">{{ c.why }}</div>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{# A compact look-ahead: one line per milestone; tap to open a short summary, with
   links on to the drug's overview and the source. #}
{% macro horizon(items, root) -%}
<section class="section">
  <div class="section-head"><h2>Coming up</h2></div>
  <div class="tl-list">
  {% for h in items %}
  {% set when = h.when or (h.date|horizon_date) %}
  {% set due = when == 'DUE NOW' %}
  <a class="tl tl-item{{ ' due' if due }}"{% if h.drug_id %} data-drug="{{ h.drug_id }}"{% endif %} href="{{ root ~ 'drugs/' ~ h.drug_id ~ '.html' if h.drug_id else h.url }}">
    <span class="tl-when">{{ "ANY WEEK NOW" if due else when }}</span>
    <span class="tl-what"><b>{{ h.drug }}</b> {{ h.short or h.what }}{% if h.context %}<span class="tl-ctx">{{ h.context }}</span>{% endif %}</span>
    <span class="go" aria-hidden="true">&rsaquo;</span>
  </a>
  {% endfor %}
  </div>
</section>
{%- endmacro %}

{# "This week": the drug changes (or just the dated heading), then what's coming up,
   then broader news. #}
{% macro this_week(w, root, title, past=0) -%}
{% set drug_changes = w.changes|rejectattr("kind", "equalto", "field")|list %}
{% set n_due = w.horizon|selectattr("when", "equalto", "DUE NOW")|list|length if w.horizon else 0 %}
<section class="section">
  {% if drug_changes %}
  <div class="section-head"><h2>{{ title }} <span class="sub">{{ w.date|nice_date_short }}</span></h2>{% if past %}<a class="btn" href="{{ root }}weeks/index.html">Past weeks &rarr;</a>{% endif %}</div>
  {% else %}
  <div class="weekline">
    <div class="weekline-top"><span class="sub">{{ w.date|nice_date_short }}</span>{% if past %}<a class="btn" href="{{ root }}weeks/index.html">Past weeks &rarr;</a>{% endif %}</div>
    <p>{% if w.baseline %}Tracking started this week.{% else %}Nothing changed this week.{% endif %}{% if n_due %} {{ n_due }} result{{ "s" if n_due != 1 }} due now.{% endif %}</p>
  </div>
  {% endif %}
  {% if w.errors %}<div class="note">Couldn't reach: {{ w.errors|join(", ") }}.{% if not w.baseline %} The previous week's data was kept for these.{% endif %}</div>{% endif %}
  {% if drug_changes %}{{ changes(drug_changes, root) }}{% endif %}
</section>
{% if w.horizon %}{{ horizon(w.horizon, root) }}{% endif %}
{% set field = w.changes|selectattr("kind", "equalto", "field")|list %}
{% if field %}
<section class="section">
  <div class="section-head"><h2>In the field <span class="sub">beyond your list</span></h2></div>
  {% for c in field %}
  <div class="change"{% if c.topic %} data-topic="{{ c.topic }}"{% endif %}>
    {% if c.topic in topics and topics|length > 1 %}<div class="meta">{{ topics[c.topic].title }}</div>{% endif %}
    <div class="what">{{ c.what }} <a class="src" href="{{ c.url }}" rel="noopener noreferrer">{{ c.source }} &rarr;</a></div>
    {% if c.why %}<div class="why">{{ c.why }}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}
{%- endmacro %}

{# The panel's header band: a line of report details, the title, then the folder tabs. #}
{% macro slab_head(active) -%}
<header class="slab-head">
  <h1 class="sr-only">Your Drugs Pipeline</h1>
  <div class="head-meta">
    {# the cabinet is where you choose which drugs you follow #}
    {% if active == "cabinet" %}<span class="hcab on" aria-current="page">Your cabinet</span>
    {% else %}<a class="hcab" href="{{ root }}cabinet.html"><span class="hback" aria-hidden="true">&larr;</span>Your cabinet</a>{% endif %}
  </div>
  {% if active != "cabinet" %}{{ tabs(active) }}{% endif %}
</header>
{%- endmacro %}

{# News / Drugs as folder tabs at the bottom of the header band. On the home page
   both panels are on the page and tabs.js switches between them in place. #}
{% macro tabs(active) -%}
<nav class="folders" aria-label="Sections">
  <a class="folder f-news{{ ' on' if active == 'news' }}" data-tab="news" href="{{ root }}index.html"{% if active == 'news' %} aria-current="page"{% endif %}><span>News</span></a>
  <a class="folder f-drugs{{ ' on' if active == 'drugs' }}" data-tab="drugs" href="{{ root }}drugs.html"{% if active == 'drugs' %} aria-current="page"{% endif %}><span>Drugs</span></a>
</nav>
{%- endmacro %}

{% macro explainer() -%}
<details class="explain">
  <summary>How to read this</summary>
  <div class="explain-body">
    <div>
      <h4>How far along</h4>
      <dl>
        <dt>Early safety tests</dt><dd>First tests in people, mainly for safety.</dd>
        <dt>Mid-stage testing</dt><dd>Does it work, and at what dose?</dd>
        <dt>Final-stage trials</dt><dd>Large trials that test whether it works well enough to approve. The last step before applying.</dd>
        <dt>FDA reviewing</dt><dd>The company has applied for approval.</dd>
        <dt>Approved</dt><dd>Doctors can prescribe it.</dd>
      </dl>
      <p style="margin-top:0.75rem">Many drugs stop along the way. Even final-stage drugs are usually a few years from pharmacies.</p>
      <h4 style="margin-top:1rem">Watching for</h4>
      <p>A short, hand-picked list of results that would change the picture. Dates are when a trial is expected to finish collecting data (they often slip); results usually follow within a few months.</p>
    </div>
    <div>
      {% for t in topics.values() if t.explain %}
      <h4{% if not loop.first %} style="margin-top:1rem"{% endif %}>{{ t.title }}</h4>
      <p>{{ t.explain }}</p>
      {% endfor %}
      <p style="margin-top:0.75rem">This is a news tracker, not medical advice.</p>
    </div>
  </div>
</details>
{%- endmacro %}

{% macro week_list(weeks, prefix) -%}
{% for w in weeks %}
<a class="w-row" href="{{ prefix }}{{ w.date }}.html"><span class="w-when">{{ w.date|nice_date }}</span><span class="w-head">{{ w.headline }}</span></a>
{% endfor %}
{%- endmacro %}
