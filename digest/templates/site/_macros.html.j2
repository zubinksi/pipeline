{% macro track(rank, moved=false) -%}
<div class="track" role="img" aria-label="{{ stages[rank-1] }}">
  {% for i in range(1, 6) %}
  <div class="cell {{ 'done' if i < rank else ('now' if i == rank else '') }}{{ ' moved' if moved and i == rank else '' }}"><span class="dot"></span></div>
  {% endfor %}
</div>
{%- endmacro %}

{% macro stage_head() -%}
<div class="strip-head"><div class="lbl"></div><div class="stages">{% for s in stages %}<div class="label">{{ s }}</div>{% endfor %}</div></div>
{%- endmacro %}

{% macro strip(rows, root, title="Pipeline", filterable=false) -%}
<div class="module"{% if filterable %} data-filter{% endif %}>
  <div class="module-head"><span class="label">{{ title }}</span></div>
  {% if filterable %}
  <div class="filters" hidden>
    <div class="f-group" role="group" aria-label="Type">
      <span class="label">Type</span>
      <button type="button" class="chip" data-k="type" data-v="all">All</button>
      {% for v, label in filters.type %}<button type="button" class="chip" data-k="type" data-v="{{ v }}">{{ label }}</button>{% endfor %}
    </div>
    <div class="f-group" role="group" aria-label="Frequency">
      <span class="label">Frequency</span>
      <button type="button" class="chip" data-k="freq" data-v="all">All</button>
      {% for v, label in filters.freq %}<button type="button" class="chip" data-k="freq" data-v="{{ v }}">{{ label }}</button>{% endfor %}
    </div>
    <span class="label f-count"></span>
  </div>
  {% endif %}
  {{ stage_head() }}
  {% for r in rows %}
  <div class="strip-row" data-type="{{ r.route or '' }}" data-freq="{{ r.frequency or '' }}">
    <div class="name">
      <a href="{{ root }}drugs/{{ r.id }}.html">{{ r.name }}</a>
      {% if r.moved %}<span class="tag moved">&#9650; moved</span>{% endif %}
      {% if r.badge %}<span class="tag">{{ r.badge }}</span>{% endif %}
      <div class="sub">{{ r.company }} · {{ r.form }}</div>
    </div>
    {{ track(r.rank, r.moved) }}
  </div>
  {% endfor %}
  {% if filterable %}<p class="empty f-empty" hidden>No drugs on the watchlist match these filters.</p>{% endif %}
</div>
{%- endmacro %}

{% macro changes(list, root, show_drug=true) -%}
{% for c in list %}
<div class="change">
  <div class="meta">
    {% if show_drug and c.drug_name %}<a href="{{ root }}drugs/{{ c.drug }}.html">{{ c.drug_name }}</a> · {{ c.company }} · {% endif %}
    {% if not show_drug and c.week %}<a href="{{ root }}weeks/{{ c.week }}.html">{{ c.week|nice_date }}</a> · {% endif %}
    <span class="kind">{{ c.kind_label }}</span>
  </div>
  <div class="what">{{ c.what }} <a class="src" href="{{ c.url }}" rel="noopener noreferrer">{{ c.source }} &rarr;</a></div>
  {% if c.why %}<div class="why"><span class="label">Why it matters</span>{{ c.why }}</div>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro horizon(items, horizon_days) -%}
<div class="module">
  <div class="module-head"><span class="label">On the horizon</span><span class="label">Next {{ horizon_days }} days</span></div>
  {% for h in items %}
  <div class="h-row">
    <div class="h-when">{{ h.date|horizon_date }}</div>
    <div class="h-what"><b>{{ h.drug }}</b>: {{ h.what }} <a class="src" href="{{ h.url }}" rel="noopener noreferrer">Source &rarr;</a></div>
  </div>
  {% endfor %}
</div>
{%- endmacro %}



{% macro week_body(w, root, horizon_days) -%}
{% if w.errors %}<div class="note">Couldn't reach: {{ w.errors|join(", ") }}.{% if not w.baseline %} The previous week's data was kept for these.{% endif %}</div>{% endif %}
<div class="module">
  <div class="module-head"><span class="label">What moved</span></div>
  {% if w.changes %}{{ changes(w.changes, root) }}
  {% elif w.baseline %}<p class="empty">First week of tracking. Changes are reported from next week.</p>
  {% else %}<p class="empty">Nothing changed this week.</p>{% endif %}
</div>
{% if w.horizon %}{{ horizon(w.horizon, horizon_days) }}{% endif %}
{%- endmacro %}

{% macro week_list(weeks, prefix) -%}
{% for w in weeks %}
<a class="w-row" href="{{ prefix }}{{ w.date }}.html"><span class="w-when">{{ w.date|nice_date }}</span><span class="w-head">{{ w.headline }}</span></a>
{% endfor %}
{%- endmacro %}
